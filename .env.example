# Waste2Worth Environment Configuration Example
# LocalStorage demo mode is active by default.
# Fill these credentials when switching to production Supabase:

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_DEMO_MODE=true

# Supabase Configuration (Optional - for future production migration)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional Vision AI Service (for production multi-modal classification)
GEMINI_API_KEY=
